{
  "name": "dsh-read-zoom",
  "version": "0.4.0",
  "type": "module",
  "description": "A reading layer for long DeepSeek Harness sessions: a fixed enlarge button on every answer opens a two-pane reading view with large-type rendered answers, a session outline and a fill-don't-send composer — so you can read papers, proofs and problem sets for hours without leaning into the screen.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reading",
    "zoom",
    "font-size",
    "long-form",
    "katex",
    "math"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "liuyifeng-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuyifeng-code/dsh-read-zoom.git"
  },
  "homepage": "https://github.com/liuyifeng-code/dsh-read-zoom#readme",
  "bugs": {
    "url": "https://github.com/liuyifeng-code/dsh-read-zoom/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
