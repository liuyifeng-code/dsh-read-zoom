{
  "name": "dsh-read-zoom",
  "version": "0.3.2",
  "type": "module",
  "description": "放大阅读：在每条回答的操作行（用量左边）常驻放大按钮，把整轮提问与回答放进全屏大字号阅读区；左栏可跳转任意轮次、随手写下一句并填入输入框，公式/化学式渲染更稳，内置数学与化学输出规约一键复制。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
